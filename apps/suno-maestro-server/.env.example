# Cle du fournisseur IA. Elle vit ICI, jamais dans l'application mobile.
ANTHROPIC_API_KEY=sk-ant-...

# Port d'ecoute (defaut 8787)
PORT=8787

# Origines autorisees, separees par des virgules. Vide = tout autoriser (dev only).
ALLOWED_ORIGINS=

# Jeton partage optionnel : si defini, l'app doit envoyer
# Authorization: Bearer <ce jeton>. Ce n'est pas la cle du fournisseur.
CLIENT_TOKEN=
